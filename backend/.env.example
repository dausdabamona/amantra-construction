# AMANTRA Construction Backend Configuration
# Copy this file to .env and configure your values

# ===========================================
# DATABASE
# ===========================================
# SQLite (Development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production - uncomment when migrating)
# DATABASE_URL="postgresql://user:password@localhost:5432/amantra_construction?schema=public"

# Supabase (Production - uncomment when migrating)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ===========================================
# JWT & AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf,application/msword

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===========================================
# RATE LIMITING
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# MIDTRANS PAYMENT GATEWAY
# ===========================================
# Get your keys from https://dashboard.midtrans.com
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx

# ===========================================
# BLOCKCHAIN INTEGRATION (Polygon)
# ===========================================
# Set to true to enable blockchain recording
BLOCKCHAIN_ENABLED=false

# RPC URL (Polygon Amoy Testnet)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology

# AmantraLedger contract address (deploy first)
BLOCKCHAIN_CONTRACT_ADDRESS=0x...

# Operator wallet private key (without 0x prefix)
# WARNING: Keep this secret! Never commit to git!
BLOCKCHAIN_PRIVATE_KEY=

# Chain ID (80002 = Polygon Amoy Testnet, 137 = Polygon Mainnet)
BLOCKCHAIN_CHAIN_ID=80002
