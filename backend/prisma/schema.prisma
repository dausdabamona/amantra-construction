// AMANTRA Construction MVP 0.1
// Sistem Kontrak Konstruksi Berbasis Amanah - Minimum Viable Product
// Fokus: 1 Proyek → 1 Kontrak → Beberapa Termin → Upload Progres → Verifikasi Berlapis → Siap Dibayar

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER - 4 ROLE ONLY
// ============================================

enum UserRole {
  OWNER       // Pemberi Kerja - Buat proyek, lihat status, konfirmasi pembayaran
  CONTRACTOR  // Kontraktor - Upload progres
  SUPERVISOR  // Pengawas - Verifikasi progres
  WITNESS     // Saksi - Verifikasi progres
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole
  name          String
  phone         String?
  company       String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedProjects   Project[]         @relation("ProjectOwner")
  contractedProjects Project[]      @relation("ProjectContractor")
  supervisedProjects Project[]      @relation("ProjectSupervisor")
  witnessedProjects  Project[]      @relation("ProjectWitness")
  progressReports    Progress[]
  verifications      Verification[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([role])
}

// ============================================
// PROJECT
// ============================================

model Project {
  id            String    @id @default(uuid())
  name          String
  description   String?
  location      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Owner
  ownerId       String
  owner         User      @relation("ProjectOwner", fields: [ownerId], references: [id])

  // Kontraktor (assigned by owner)
  contractorId  String?
  contractor    User?     @relation("ProjectContractor", fields: [contractorId], references: [id])

  // Pengawas (assigned by owner)
  supervisorId  String?
  supervisor    User?     @relation("ProjectSupervisor", fields: [supervisorId], references: [id])

  // Saksi (assigned by owner)
  witnessId     String?
  witness       User?     @relation("ProjectWitness", fields: [witnessId], references: [id])

  // One project has one contract
  contract      Contract?

  @@index([ownerId])
}

// ============================================
// CONTRACT - 1 per Project
// ============================================

model Contract {
  id              String    @id @default(uuid())
  contractNumber  String    @unique
  totalValue      Float     // Nilai kontrak total
  termCount       Int       // Jumlah termin

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id])

  terms           Term[]

  @@index([contractNumber])
}

// ============================================
// TERM (TERMIN)
// Status flow: DRAFT → SUBMITTED → VERIFIED → VALID → PAID
// ============================================

enum TermStatus {
  DRAFT           // Belum ada progres
  SUBMITTED       // Progres sudah diajukan, menunggu verifikasi
  VERIFIED        // Sedang diverifikasi (minimal 1 sudah approve)
  VALID           // 2 verifikasi disetujui, siap dibayar
  REJECTED        // Ditolak, perlu revisi
  PAID            // Sudah dibayar
}

model Term {
  id              String      @id @default(uuid())
  termNumber      Int         // Termin ke-berapa (1, 2, 3, ...)
  name            String      // Nama termin (e.g., "Pekerjaan Pondasi")
  description     String?
  percentage      Float       // Persentase dari total kontrak (e.g., 30%)
  value           Float       // Nilai termin dalam Rupiah
  status          TermStatus  @default(DRAFT)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id])

  progress        Progress[]
  verifications   Verification[]
  payment         Payment?

  @@unique([contractId, termNumber])
  @@index([contractId])
  @@index([status])
}

// ============================================
// PROGRESS - Upload progres oleh Kontraktor
// ============================================

model Progress {
  id              String    @id @default(uuid())
  description     String    // Deskripsi pekerjaan yang sudah dilakukan
  photoUrl        String?   // URL foto bukti (local path)
  claimPercentage Float     // Persentase klaim progres (e.g., 80%)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  termId          String
  term            Term      @relation(fields: [termId], references: [id])

  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])

  @@index([termId])
}

// ============================================
// VERIFICATION - Verifikasi oleh Pengawas & Saksi
// ============================================

enum VerificationRole {
  SUPERVISOR  // Pengawas
  WITNESS     // Saksi
}

enum VerificationStatus {
  PENDING   // Belum diverifikasi
  APPROVED  // Disetujui
  REJECTED  // Ditolak
}

model Verification {
  id              String              @id @default(uuid())
  role            VerificationRole    // Apakah ini verifikasi pengawas atau saksi
  status          VerificationStatus  @default(PENDING)
  notes           String?             // Catatan verifikasi

  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  termId          String
  term            Term                @relation(fields: [termId], references: [id])

  verifierId      String
  verifier        User                @relation(fields: [verifierId], references: [id])

  @@unique([termId, role]) // Satu termin hanya bisa diverifikasi 1x per role
  @@index([termId])
  @@index([verifierId])
}

// ============================================
// PAYMENT - Status pembayaran per termin
// ============================================

enum PaymentStatus {
  PENDING     // Menunggu (belum valid)
  READY       // Siap dibayar (status termin = VALID)
  PAID        // Sudah dibayar
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float         // Jumlah yang dibayar
  status          PaymentStatus @default(PENDING)
  proofUrl        String?       // URL bukti transfer
  transactionRef  String?       // Nomor referensi transfer
  paidAt          DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  termId          String        @unique
  term            Term          @relation(fields: [termId], references: [id])

  @@index([status])
}

// ============================================
// AUDIT LOG - Semua aksi tercatat
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SUBMIT_PROGRESS
  VERIFY_APPROVE
  VERIFY_REJECT
  PAYMENT_CONFIRM
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String      // "Project", "Contract", "Term", "Progress", "Verification", "Payment"
  entityId    String
  description String
  oldValue    String?     // JSON
  newValue    String?     // JSON

  createdAt   DateTime    @default(now())

  // Who did it
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
