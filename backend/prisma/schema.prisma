// AMANTRA Construction MVP 0.1
// Sistem Kontrak Konstruksi Berbasis Amanah - Minimum Viable Product
// SQLite compatible - using String instead of enum

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER - 4 ROLE ONLY
// Roles: OWNER, CONTRACTOR, SUPERVISOR, WITNESS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          String    // OWNER, CONTRACTOR, SUPERVISOR, WITNESS
  name          String
  phone         String?
  company       String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedProjects      Project[]         @relation("ProjectOwner")
  contractedProjects Project[]         @relation("ProjectContractor")
  supervisedProjects Project[]         @relation("ProjectSupervisor")
  witnessedProjects  Project[]         @relation("ProjectWitness")
  progressReports    Progress[]
  verifications      Verification[]
  auditLogs          AuditLog[]
  auditTrailRecords  AuditTrail[]

  @@index([email])
  @@index([role])
}

// ============================================
// PROJECT
// ============================================

model Project {
  id            String    @id @default(uuid())
  name          String
  description   String?
  location      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Owner
  ownerId       String
  owner         User      @relation("ProjectOwner", fields: [ownerId], references: [id])

  // Kontraktor (assigned by owner)
  contractorId  String?
  contractor    User?     @relation("ProjectContractor", fields: [contractorId], references: [id])

  // Pengawas (assigned by owner)
  supervisorId  String?
  supervisor    User?     @relation("ProjectSupervisor", fields: [supervisorId], references: [id])

  // Saksi (assigned by owner)
  witnessId     String?
  witness       User?     @relation("ProjectWitness", fields: [witnessId], references: [id])

  // One project has one contract
  contract      Contract?

  @@index([ownerId])
}

// ============================================
// CONTRACT - 1 per Project
// ============================================

model Contract {
  id              String    @id @default(uuid())
  contractNumber  String    @unique
  totalValue      Float     // Nilai kontrak total
  termCount       Int       // Jumlah termin
  status          String    @default("INTENT_DECLARED") // Global state
  lockedAt        DateTime?
  cooldownExpiresAt DateTime?
  executionStartedAt DateTime?
  evaluationStartedAt DateTime?
  closedAt        DateTime?
  ownerApproved   Boolean   @default(false)
  contractorApproved Boolean @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id])

  terms           Term[]
  evaluations     EvaluationRecord[]
  calculations    CalculationResult[]
  finalRights     FinalRights?
  distributions   DistributionInstruction[]
  executionLogs   TransferExecutionLog[]
  archive         ContractArchive?
  finalReports    FinalReport[]
  auditTrails     AuditTrail[]

  @@index([contractNumber])
}

// ============================================
// TERM (TERMIN)
// Status: DRAFT, SUBMITTED, VERIFIED, VALID, REJECTED, PAID
// ============================================

model Term {
  id              String      @id @default(uuid())
  termNumber      Int         // Termin ke-berapa (1, 2, 3, ...)
  name            String      // Nama termin (e.g., "Pekerjaan Pondasi")
  description     String?
  percentage      Float       // Persentase dari total kontrak (e.g., 30%)
  value           Float       // Nilai termin dalam Rupiah
  status          String      @default("DRAFT") // DRAFT, SUBMITTED, VERIFIED, VALID, REJECTED, PAID

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  contractId      String
  contract        Contract    @relation(fields: [contractId], references: [id])

  progress        Progress[]
  verifications   Verification[]
  payment         Payment?

  @@unique([contractId, termNumber])
  @@index([contractId])
  @@index([status])
}

// ============================================
// PROGRESS - Upload progres oleh Kontraktor
// ============================================

model Progress {
  id              String    @id @default(uuid())
  description     String    // Deskripsi pekerjaan yang sudah dilakukan
  photoUrl        String?   // URL foto bukti (local path)
  claimPercentage Float     // Persentase klaim progres (e.g., 80%)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  termId          String
  term            Term      @relation(fields: [termId], references: [id])

  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])

  @@index([termId])
}

// ============================================
// VERIFICATION - Verifikasi oleh Pengawas & Saksi
// Role: SUPERVISOR, WITNESS
// Status: PENDING, APPROVED, REJECTED
// ============================================

model Verification {
  id              String    @id @default(uuid())
  role            String    // SUPERVISOR, WITNESS
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes           String?   // Catatan verifikasi

  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  termId          String
  term            Term      @relation(fields: [termId], references: [id])

  verifierId      String
  verifier        User      @relation(fields: [verifierId], references: [id])

  @@unique([termId, role]) // Satu termin hanya bisa diverifikasi 1x per role
  @@index([termId])
  @@index([verifierId])
}

// ============================================
// PAYMENT - Status pembayaran per termin
// Status: PENDING, READY, PAID
// ============================================

model Payment {
  id              String    @id @default(uuid())
  amount          Float     // Jumlah yang dibayar
  status          String    @default("PENDING") // PENDING, READY, PAID
  proofUrl        String?   // URL bukti transfer
  transactionRef  String?   // Nomor referensi transfer
  paidAt          DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  termId          String    @unique
  term            Term      @relation(fields: [termId], references: [id])

  @@index([status])
}

// ============================================
// EVALUATION & CALCULATION (STATE 4)
// ============================================

model EvaluationRecord {
  id                 String   @id @default(uuid())
  contractId         String   @unique
  state              String   @default("EVALUATION_AND_CALCULATION")
  waitingState       String   @default("WAITING_FOR_AUDIT")
  isDataFrozen       Boolean  @default(true)
  objectionStatus    String   @default("NONE")
  correctionRounds   Int      @default(0)
  objectionDeadline  DateTime?
  correctionDeadline DateTime?
  calculationHash    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  contract           Contract @relation(fields: [contractId], references: [id])
  calculationResults CalculationResult[]

  @@index([waitingState])
  @@index([objectionStatus])
}

model CalculationResult {
  id                  String    @id @default(uuid())
  contractId          String
  evaluationId        String?
  version             Int       @default(1)
  breakdown           String    // JSON serialized
  provisional         String    // JSON serialized
  verifiedPerformance String    // JSON serialized
  appliedClauses      String    // JSON serialized
  objection           String?   // JSON serialized
  isFinal             Boolean   @default(false)
  approvedBy          String?
  finalizedAt         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  contract            Contract  @relation(fields: [contractId], references: [id])
  evaluation          EvaluationRecord? @relation(fields: [evaluationId], references: [id])

  @@index([contractId])
  @@index([isFinal])
}

// ============================================
// RIGHTS FINALIZATION & DISTRIBUTION (STATE 5)
// ============================================

model FinalRights {
  id                 String   @id @default(uuid())
  contractId         String   @unique
  calculationHash    String
  finalShareInvestor Float
  finalShareOperator Float
  fees               Float    @default(0)
  penalties          Float    @default(0)
  currency           String   @default("IDR")
  approvedBy         String?
  approvedAt         DateTime?
  txStatus           String   @default("PENDING") // PENDING, CONFIRMED, FAILED

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  contract           Contract @relation(fields: [contractId], references: [id])
  instructions       DistributionInstruction[]
  executionLogs      TransferExecutionLog[]
}

model DistributionInstruction {
  id            String   @id @default(uuid())
  contractId    String
  finalRightsId String
  beneficiary   String
  role          String   // INVESTOR, OPERATOR, FEE, PENALTY
  amount        Float
  status        String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  txHash        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  finalRights    FinalRights @relation(fields: [finalRightsId], references: [id])
  contract       Contract    @relation(fields: [contractId], references: [id])
  executionLogs  TransferExecutionLog[]

  @@index([contractId])
  @@index([status])
}

model TransferExecutionLog {
  id             String   @id @default(uuid())
  contractId     String
  finalRightsId  String
  instructionId  String?
  action         String
  status         String
  message        String
  txHash         String?
  executedBy     String?

  createdAt      DateTime @default(now())

  finalRights    FinalRights @relation(fields: [finalRightsId], references: [id])
  contract       Contract    @relation(fields: [contractId], references: [id])
  instruction    DistributionInstruction? @relation(fields: [instructionId], references: [id])

  @@index([contractId])
  @@index([action])
  @@index([status])
}

// ============================================
// CONTRACT ARCHIVE (STATE 6)
// ============================================

model ContractArchive {
  id                   String   @id @default(uuid())
  contractId           String   @unique
  finalState           String   @default("CONTRACT_CLOSED_AND_ARCHIVED")
  finalHash            String?
  finalRightsSnapshot  String?  // JSON serialized
  transitionLog        String?  // JSON serialized
  transactionHashes    String?  // JSON serialized (comma-separated or JSON array)
  phaseTimestamps      String?  // JSON serialized
  distributionCompleted Boolean @default(false)
  archivedAt           DateTime @default(now())
  closedBy             String?
  notes                String?

  contract             Contract @relation(fields: [contractId], references: [id])
  finalReport          FinalReport?
  auditTrails          AuditTrail[]
}

model FinalReport {
  id          String   @id @default(uuid())
  contractId  String
  archiveId   String   @unique
  title       String
  summary     String?
  totalFunds  Float?
  totalResult String?
  durationDays Int?
  documentUrl String?
  createdAt   DateTime @default(now())

  contract    Contract        @relation(fields: [contractId], references: [id])
  archive     ContractArchive @relation(fields: [archiveId], references: [id])

  @@index([contractId])
  @@index([archiveId])
}

model AuditTrail {
  id         String   @id @default(uuid())
  contractId String
  archiveId  String
  action     String
  message    String
  actorId    String?
  txHash     String?
  createdAt  DateTime @default(now())

  contract   Contract        @relation(fields: [contractId], references: [id])
  archive    ContractArchive @relation(fields: [archiveId], references: [id])
  actor      User?           @relation(fields: [actorId], references: [id])

  @@index([contractId])
  @@index([archiveId])
  @@index([action])
}

// ============================================
// AUDIT LOG - Semua aksi tercatat
// Action: CREATE, UPDATE, DELETE, LOGIN, SUBMIT_PROGRESS, VERIFY_APPROVE, VERIFY_REJECT, PAYMENT_CONFIRM
// ============================================

model AuditLog {
  id          String    @id @default(uuid())
  action      String    // CREATE, UPDATE, DELETE, LOGIN, SUBMIT_PROGRESS, VERIFY_APPROVE, VERIFY_REJECT, PAYMENT_CONFIRM
  entityType  String    // "Project", "Contract", "Term", "Progress", "Verification", "Payment"
  entityId    String
  description String
  oldValue    String?   // JSON
  newValue    String?   // JSON

  createdAt   DateTime  @default(now())

  // Who did it
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
